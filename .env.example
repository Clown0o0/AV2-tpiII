# Copie este arquivo para .env e troque USUARIO e SENHA (e, se precisar, host, porta e nome do banco)
# pelos do seu PostgreSQL. Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/cinebridge_recomendacao?schema=public"
PORT=3000

# Opcionais (os valores abaixo são os padrões; tire o # para mudar):
# HOST=0.0.0.0
# LOG_LEVEL=info
# CATALOGO_TTL_MS=60000
# PROFISSIONAIS_TIMEOUT_MS=1500
# SEED_PROFISSIONAIS=300
